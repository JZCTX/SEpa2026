@startuml
left to right direction
skinparam defaultFontName "Microsoft YaHei"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam usecaseFontSize 14
skinparam nodesep 8
skinparam ranksep 34
skinparam packageStyle rectangle

title 外卖点餐与配送系统 UML 用例图（最终版）

actor "顾客" as C
actor "商家" as M
actor "配送员" as D
actor "平台管理员" as A

rectangle "外卖点餐与配送系统" {
  usecase "注册 / 登录" as U01
  usecase "浏览与搜索菜品" as U02
  usecase "购物车与提交订单" as U03
  usecase "支付 / 取消 / 退款" as U04
  usecase "查询订单与跟踪状态" as U05

  usecase "店铺与营业状态管理" as U06
  usecase "菜品与库存管理" as U07
  usecase "接单 / 拒单 / 出餐" as U08
  usecase "分配配送员" as U09
  usecase "查看本店订单与统计" as U10

  usecase "接取与完成配送" as U11
  usecase "上报配送失败" as U12

  usecase "审核店铺资质" as U13
  usecase "处理异常订单" as U14
  usecase "平台统计与日志查询" as U15
  usecase "校验库存与幂等" as U16
}

C --> U01
C --> U02
C --> U03
C --> U04
C --> U05

M --> U01
M --> U06
M --> U07
M --> U08
M --> U09
M --> U10

D --> U01
D --> U11
D --> U12

A --> U01
A --> U13
A --> U14
A --> U15

U03 .> U16 : <<include>>
U04 .> U16 : <<include>>

@enduml
