@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activityFontSize 14
skinparam ArrowFontSize 11
skinparam nodesep 20
skinparam ranksep 28

title 外卖点餐与配送系统 UML 活动图：下单校验与扣库存（最终版）

start
:提交订单（含幂等键）;
if (已登录且为顾客?) then (否)
  #FFECEC:拒绝：401/403;
  stop
else (是)
endif
if (幂等键已存在?) then (是)
  #EAF7EE:返回原订单，不重复扣库存;
  stop
else (否)
endif
if (店铺营业且在售?) then (否)
  #FFECEC:提示歇业/已下架;
  stop
else (是)
endif
:读取当前价并生成价格快照;
:逐菜品原子扣减库存;
if (全部扣减成功?) then (否)
  #FFF6E5:回滚已扣库存;
  #FFECEC:提示售罄;
  stop
else (是)
endif
:事务保存订单与明细快照;
:写入幂等键（24h）;
:返回订单号，状态=待支付;
if (模拟支付成功?) then (是)
  #EAF7EE:已支付，通知商家;
else (否)
  #FFF6E5:保持待支付，可重试或取消;
endif
stop

@enduml
